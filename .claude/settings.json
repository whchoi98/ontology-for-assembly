{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scrub-secrets.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scrub-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scrub-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/changelog-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(* --require-approval never*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf /home/*)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref -d*)",
      "Bash(git reflog expire*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(eval *)",
      "Bash(chmod 777 *)",
      "Bash(aws iam delete-user*)",
      "Bash(aws iam delete-role*)",
      "Bash(aws iam delete-policy*)",
      "Bash(aws iam create-access-key*)",
      "Bash(aws iam put-user-policy*)",
      "Bash(aws iam put-role-policy*)",
      "Bash(aws iam put-group-policy*)",
      "Bash(aws iam attach-user-policy*)",
      "Bash(aws iam attach-role-policy*)",
      "Bash(aws iam create-policy-version*)",
      "Bash(aws iam set-default-policy-version*)",
      "Bash(aws iam update-assume-role-policy*)",
      "Bash(aws iam pass-role*)",
      "Bash(aws iam create-role*)",
      "Bash(aws s3 rb *)",
      "Bash(aws s3api delete-bucket*)",
      "Bash(aws cloudfront delete-distribution*)",
      "Bash(aws cloudfront delete-function*)",
      "Bash(aws cognito-idp delete-user-pool*)",
      "Bash(aws cloudtrail delete-trail*)",
      "Bash(aws cloudtrail stop-logging*)",
      "Bash(aws neptune delete-db-cluster*)",
      "Bash(aws neptune delete-db-instance*)",
      "Bash(aws ecr delete-repository*)",
      "Bash(aws ecr batch-delete-image*)",
      "Bash(aws secretsmanager delete-secret*)",
      "Bash(aws ssm delete-parameter*)",
      "Bash(aws bedrock-agentcore-control delete-*)",
      "Bash(aws bedrock delete-guardrail*)",
      "Bash(aws route53 delete-hosted-zone*)",
      "Bash(aws apigateway delete-*)",
      "Bash(aws apigatewayv2 delete-*)",
      "Bash(aws dynamodb delete-table*)",
      "Bash(aws lambda delete-function*)",
      "Bash(cdk destroy*)",
      "Bash(npx cdk destroy*)",
      "Bash(dd if=*of=/dev/*)",
      "Bash(mkfs*)",
      "mcp__bedrock-agentcore-mcp-server__delete_agent_runtime",
      "mcp__bedrock-agentcore-mcp-server__delete_agent_runtime_endpoint",
      "mcp__bedrock-agentcore-mcp-server__execute_command",
      "mcp__bedrock-agentcore-mcp-server__execute_code",
      "mcp__plugin_serena_serena__execute_shell_command",
      "mcp__plugin_serena_serena__delete_memory"
    ]
  }
}
