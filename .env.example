# ontology-for-assembly — 환경 변수 예시
# 실제 값은 CDK output에서 자동 해석되거나 Secrets Manager / SSM Parameter Store에 보관.
# 절대 실 값으로 채워서 commit 금지 (.gitignore가 .env는 제외, .env.example만 commit).

# ─────── 공통 ───────
AWS_REGION=ap-northeast-2
ASSEMBLY_ENV=dev
PUBLIC_DOMAIN=                       # CDK output에서 자동 (첫 배포는 cloudfront.net)

# ─────── Neptune ───────
NEPTUNE_ENDPOINT=                    # writer endpoint
NEPTUNE_PORT=8182

# ─────── OpenSearch Serverless ───────
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=ontology-assembly-dev-kb-index

# ─────── Bedrock ───────
BEDROCK_CHAT_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL_ID=global.cohere.embed-v4:0
BEDROCK_RERANKER_INFERENCE_PROFILE_ARN=
BEDROCK_KB_ID=
BEDROCK_GUARDRAIL_ID=                # 정치 중립성·정당 비방 차단 가드레일 (ADR-0004)

# ─────── AgentCore ───────
AGENTCORE_MEMORY_ID=                 # short-term session + long-term reader namespaces

# ─────── 인증 ───────
COGNITO_USER_POOL_ID=                # staff / subscriber 그룹 분리
COGNITO_GUEST_IDENTITY_POOL_ID=      # 일반 독자 익명 접근
COGNITO_APP_CLIENT_ID=
ORIGIN_AUTH_SECRET_ARN=              # CloudFront ↔ ALB 공유 토큰

# ─────── 외부 API (시나리오 J) ───────
KMA_API_KEY=                         # 기상청 (필요 시 - 시나리오 N에 사용 시)
NAVER_NEWS_API_CLIENT_ID=            # 네이버 뉴스 RSS (시나리오 J)
NAVER_NEWS_API_CLIENT_SECRET=
POLL_SOURCE_ENDPOINT=                # 한국갤럽/리얼미터 등 (or 합성)

# ─────── 국회 OpenAPI ───────
ASSEMBLY_OPENAPI_KEY=                # https://open.assembly.go.kr 발급키

# ─────── S3 버킷 ───────
RAW_DOCS_BUCKET=ontology-assembly-dev-raw-docs-<account>
UPLOADS_BUCKET=ontology-assembly-dev-uploads-<account>
SYNTHETIC_DATA_BUCKET=ontology-assembly-dev-synthetic-data-<account>

# ─────── B2B SaaS ───────
B2B_API_KEY_TABLE=ontology-assembly-dev-b2b-keys

# ─────── 데모 모드 (테스트·발표용) ───────
DEMO_PUBLIC_MODE=false               # true면 Cognito 인증 우회 (PoC 시연 한정)
REQUIRE_ORIGIN_AUTH=true             # production은 항상 true

# ─────── 광고 매칭 (시나리오 L) ───────
AD_MATCH_MODE=agent                  # keyword | embedding | agent (3-way 비교)
AD_INVENTORY_TABLE=ontology-assembly-dev-ad-inventory
