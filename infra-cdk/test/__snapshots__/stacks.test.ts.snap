          "ManagedWordListsConfig": [
            {
              "Type": "PROFANITY",
            },
          ],
        },
      },
      "Type": "AWS::Bedrock::Guardrail",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
